<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="325" d:DesignHeight="285"
        x:Class="LayoutUsingPanels.Panels.SimpleWrapPanel"
        Title="Simple Wrap Panel" Width="325" Height="285">

    <!-- A WrapPanel allows you to define content that will flow across the panel as the window is resized. -->

    <WrapPanel Background="LightSteelBlue" Orientation="Horizontal">

        <Label Name="LblInstruction" Width="328" Height="27" FontSize="15" FontWeight="Bold"
               Content="Enter Car Information" />

        <Label Name="LblMake" FontWeight="Bold" Content="Make" />
        <TextBox Name="TxtMake" Width="193" Height="25" />

        <Label Name="LblColor" FontWeight="Bold" Content="Color" />
        <TextBox Name="TxtColor" Width="193" Height="25" />

        <Label Name="LblPetName" FontWeight="Bold" Content="Pet Name" />
        <TextBox Name="TxtPetName" Width="193" Height="25" />

        <Button Name="BtnOk" Width="80" FontWeight="Bold" HorizontalContentAlignment="Center" Content="OK" />

    </WrapPanel>

</Window>