<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="325" d:DesignHeight="285"
        x:Class="LayoutUsingPanels.Panels.SimpleDockPanel"
        Title="Simple Dock Panel" Width="325" Height="285">

    <!-- DockPanel is typically used as a container that holds any number of additional panels for grouping related content. -->

    <DockPanel LastChildFill="True" Background="AliceBlue">

        <Label DockPanel.Dock="Top" Name="LblInstruction" FontSize="15" FontWeight="Bold"
               Content="Enter Car Information" />

        <Label DockPanel.Dock="Left" Name="LblMake" FontWeight="Bold" Content="Make" />

        <Label DockPanel.Dock="Right" Name="LblColor" FontWeight="Bold" Content="Color" />

        <Label DockPanel.Dock="Bottom" Name="LblPetName" FontWeight="Bold" Content="Pet Name" />

        <Button Name="BtnOk" FontWeight="Bold" HorizontalContentAlignment="Center" Content="OK" />

    </DockPanel>

</Window>