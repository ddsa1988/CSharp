<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="325" d:DesignHeight="285"
        x:Class="LayoutUsingPanels.Panels.SimpleScrollViwer"
        Title="Scrolling ForPanel Types" Width="325" Height="285">

    <!-- Provides automatic scrolling behaviors for data within panel objects. -->

    <ScrollViewer>
        <StackPanel>
            <Button Content="First" Background="Green" Width="325" Height="50" FontWeight="Bold" />
            <Button Content="Second" Background="Red" Width="325" Height="50" FontWeight="Bold" />
            <Button Content="Third" Background="Pink" Width="325" Height="50" FontWeight="Bold" />
            <Button Content="Fourth" Background="Yellow" Width="325" Height="50" FontWeight="Bold" />
            <Button Content="Fifth" Background="LightBlue" Width="325" Height="50" FontWeight="Bold" />
        </StackPanel>
    </ScrollViewer>

</Window>