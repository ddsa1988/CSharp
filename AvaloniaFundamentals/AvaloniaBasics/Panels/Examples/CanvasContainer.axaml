<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Panels.Examples.CanvasContainer"
        Title="CanvasContainer" Width="800" Height="450">

    <Canvas Background="AliceBlue" Margin="10">
        <Rectangle Fill="Red" Width="100" Height="100" Canvas.Left="100" Canvas.Top="100" />
        <Rectangle Fill="Blue" Width="100" Height="100" Canvas.Left="150" Canvas.Top="150" />
        <Rectangle Fill="Green" Width="100" Height="100" Canvas.Left="200" Canvas.Top="200" />
        <Rectangle Fill="Orange" Width="100" Height="100" Canvas.Left="250" Canvas.Top="250" />
    </Canvas>

</Window>