<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Panels.Examples.StackPanelContainer"
        Title="StackPanelContainer" Width="800" Height="450">

    <Border BorderBrush="LightBlue" BorderThickness="10" Margin="10" Padding="10">
        <StackPanel Orientation="Vertical" Spacing="20">
            <Border BorderBrush="LightCoral" BorderThickness="10" Padding="20">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Sample controls" Margin="5" />
                    <Button Content="Test button" Margin="5" />
                </StackPanel>
            </Border>
            <Border BorderBrush="LightGreen" BorderThickness="10" Padding="20">
                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="Sample controls" Margin="5" />
                    <Button Content="Test button" Margin="5" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>