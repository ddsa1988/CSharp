<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
        x:Class="Controls.Views.ImagesWindow"
        Title="ImagesWindow" Width="600" Height="450">

    <StackPanel Name="StackPanel1" Orientation="Vertical" Margin="10" Spacing="10">
        <!-- "Ensure the file is set to AvaloniaResource in .csproj" => <AvaloniaResource Include="Assets/**"/> -->
        <Image Source="avares://Controls/Assets/img-1.png" Stretch="UniformToFill" Width="500" />
    </StackPanel>

</Window>